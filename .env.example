PORT=3000
NODE_ENV=development

# ── Notion source database ────────────────────────────────────────────────
# See docs/notion-source-database.md. To set all of this up from scratch in a
# fresh workspace, run:  npm run notion:setup

# Personal access token, from https://www.notion.so/developers/tokens
# (New token -> tick the "Notion API" capability. Starts ntn_, shown once.)
# An internal connection's secret also works, but then the parent page must be
# shared with it explicitly: page -> ... menu -> Connections.
#
# LEFT BLANK ON PURPOSE: this file is committed and the repo is public.
# Put the real token in .env, which is gitignored. Never here.
NOTION_TOKEN=

# The values below are the live ones for the demo workspace (Qiuyi's Notion),
# recorded on issue #5. They are ids, not credentials: useless without a token
# that has access to that workspace. If you are seeding your OWN workspace,
# `npm run notion:setup` overwrites all three in .env with yours.

# The page the database is created under ("notion2attio - source data")
NOTION_PARENT_PAGE_ID=3cbfb014-d084-8155-b1d2-e66af9f5395c

# Written by scripts/seed-notion-source-db.mjs
NOTION_DATABASE_ID=56c04ba2-8869-4aa4-b438-e638ecf45a47
# Queries go to the DATA SOURCE, not the database:
# POST /v1/data_sources/{NOTION_DATA_SOURCE_ID}/query
NOTION_DATA_SOURCE_ID=7cf1f1a3-6986-49b5-bb54-8c03678b9428

# ── Research-notes screening ──────────────────────────────────────────────
# See docs/adr/0002-a-model-may-only-raise-a-flag.md. One call per source row
# reads `Research notes` and raises the N1/N2 notice Warns. Model:
# gpt-5.6-luna, reasoning effort `low`, structured output, max_tokens 1024.
#
# OPTIONAL. With no key the check node skips screening and the batch carries a
# notice-level batch flag ("The research notes were not read"). The run still
# completes — a missing key never silently produces a clean batch.
#
# LEFT BLANK ON PURPOSE: this file is committed and the repo is public.
# Put the real key in .env, which is gitignored. Never here.
OPENAI_API_KEY=
